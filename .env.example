# ==============================================================================
# WMS TRANSPORT — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development or set in production host.
# Do not store sensitive credentials or production secret keys in this file.

# Canonical Production URL (Without trailing slash)
NEXT_PUBLIC_SITE_URL=https://wms-transport.com

# Google Analytics 4 Measurement ID
# Set to your verified GA4 Stream ID (e.g., G-XXXXXXXXXX)
# If empty or set to placeholder, analytics scripts gracefully no-op without errors.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Ads Tag ID (e.g., AW-XXXXXXXXXX or numeric ID)
# When set, loads Google tag (gtag.js) and configures Google Ads measurement.
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Google Ads Conversion Action Labels (Optional)
# If using GA4 Imported Key Events (recommended), leave these blank to prevent double counting.
# If using direct Google Ads conversions, provide the label from Google Ads conversion action.
NEXT_PUBLIC_GOOGLE_ADS_PHONE_CONVERSION_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_LINE_CONVERSION_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_QUOTE_CONVERSION_LABEL=

# Ads dashboard: server-only configuration. No default credentials.
ADS_SUPABASE_URL=
ADS_SUPABASE_PUBLIC_KEY=
ADS_SUPABASE_SECRET_KEY=
ADS_MANAGER_EMAILS=
ADS_VIEWER_EMAILS=

# Database Connection (Neon / Postgres for Quotations & Audit Logs - Server-only)
DATABASE_URL=

# LINE Integration (Server-only)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_SETUP_PASSCODE=
LINE_NOTIFICATION_GROUP_ID=

# WMS SEO Monitor — Google Search Console API (Server-only)
# Generated from Google Cloud Service Account with webmasters.readonly permission
GSC_SERVICE_ACCOUNT_EMAIL=
# Store private key with \n line breaks as single string or base64 encoded
GSC_PRIVATE_KEY=
SEO_DASHBOARD_PASSCODE=

